{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "plain",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "topFilesLength": 0,
    "showSummary": false,
    "showDirectoryStructure": false,
    "headerText": "#TASK\n\n\n\n\n#PROJECT FILES\n\n\n"
  },
  "include": [
    "app/**/*",
    "proxy.ts",
    "scripts/**/*",
    "package.json",
    "next.config.ts",
    "tsconfig.json",
    "eslint.config.mjs",
    "repomix.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules",
      ".next",
      ".git",
      ".vercel",
      "pnpm-lock.yaml",
      "package-lock.json",
      "public/**/*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.svg",
      "**/*.ico",
      "**/*.pdf",
      "**/*.lock",
      "**/*.pem",
      "**/*.key",
      "**/dist/**",
      "repomix-output.txt",
      "repomix.temp.*",
      "project-context.txt",
      "ctx-map.txt",
      ".claude/settings.local.json",
      "**/.env*",
      ".env*",
      ".env.local",
      "**/.env.local"
    ]
  }
}